# Copy to .env and adjust. Every value shown is the default unless noted.

# PostgreSQL connection (docker-compose sets this for you).
DATABASE_URL=postgres://fleet:fleet@localhost:5432/fleet?sslmode=disable
# Password for the compose postgres service (compose only).
POSTGRES_PASSWORD=fleet

# Listen addresses: HTTP API/UI and Teltonika gateway (TCP and UDP on the same port).
HTTP_ADDR=:8080
TELTONIKA_ADDR=:5027

# Secret used to sign login tokens (HS256). REQUIRED in production; if empty a
# random one is generated and users are logged out on every restart.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Default admin, created on first start when no users exist.
ADMIN_EMAIL=admin@fleet.local
ADMIN_PASSWORD=admin

# Register unknown IMEIs automatically on first connection.
AUTO_REGISTER=true
# A device is "offline" when nothing was received for this long.
OFFLINE_AFTER=10m

# Built web UI to serve (SPA). Ignored if the directory does not exist.
WEB_DIR=../web/dist
# Allowed browser origins for CORS (comma-separated, * = any, empty = same-origin only).
CORS_ORIGIN=*

# Telegram Bot API base URL (override for a local Bot API server or tests).
# The bot token itself is set in the web UI under Settings.
TELEGRAM_API_URL=https://api.telegram.org
# Contact for Web Push services (VAPID "sub"): a mailto: or https:// URL.
VAPID_SUBJECT=mailto:admin@fleet.local

# debug | info | warn | error, and text | json.
LOG_LEVEL=info
LOG_FORMAT=text
